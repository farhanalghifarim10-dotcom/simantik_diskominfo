# Server Configuration
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Supabase Service Role Integration (Backend Only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# Security & Session Token Secret (WAJIB diisi, minimal 32 karakter, tanpa nilai default)
JWT_SECRET=

# Reverse Proxy Configuration (Production)
# WAJIB diset true jika backend berjalan di balik reverse proxy / load balancer (Nginx, Caddy, Traefik, Cloudflare, dll.).
# KONSEKUENSI jika false di lingkungan reverse proxy:
# Express tidak akan mempercayai header X-Forwarded-For, sehingga seluruh klien terdeteksi sebagai satu IP proxy (127.0.0.1).
# Hal ini menyebabkan batas rate limiter (Throttler) terbagi ke semua pengguna sekaligus dan memicu blokir massal (HTTP 429).
TRUST_PROXY=false

# Resend Email Integration (Backend Only)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=SIMANTIK Diskominfo <noreply@simantik.bandungkab.go.id>