# Server Configuration
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Supabase Service Role Integration (Backend Only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# Security & Session Token Secret (WAJIB diisi, minimal 32 karakter, tanpa nilai default)
JWT_SECRET=

# Reverse Proxy Configuration (Production)
# REKOMENDASI KEAMANAN: Isi dengan jumlah hop proxy yang tepat (misal: 1 jika di balik Nginx).
# JANGAN diset "true", karena Express akan mempercayai semua hop X-Forwarded-For sehingga rentan IP spoofing.
# KONSEKUENSI jika bernilai 0/false saat di balik reverse proxy: seluruh klien terdeteksi sebagai IP 127.0.0.1
# sehingga batas rate limiter (100 req/menit) terbagi bersamaan dan memicu blokir 429 massal.
# Nilai yang didukung: 0 atau false (pengembangan lokal), 1 (1 layer proxy), 2 (2 layer proxy).
TRUST_PROXY=0

# Resend Email Integration (Backend Only)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=SIMANTIK Diskominfo <noreply@simantik.bandungkab.go.id>