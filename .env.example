# SIMANTIK - Master Environment Configuration Template
# Untuk konfigurasi per komponen terpisah, lihat juga:
# - backend/api/.env.example
# - frontend/service-web/.env.example
# - frontend/admin-web/.env.example

# ==========================================
# BACKEND API (NestJS)
# ==========================================
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Supabase Service Role Integration (Wajib di backend, JANGAN diekspos ke client)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# Kunci Rahasia Sesi Token Pelacakan Publik (WAJIB diisi, minimal 32 karakter)
# Aplikasi backend akan gagal boot jika variabel ini kosong atau < 32 karakter.
JWT_SECRET=

# Reverse Proxy Configuration (Production)
# REKOMENDASI KEAMANAN: Isi dengan jumlah hop proxy yang tepat (misal: 1 jika di balik Nginx).
# JANGAN diset "true", karena Express akan mempercayai seluruh hop X-Forwarded-For sehingga rentan pemalsuan IP asal (IP spoofing).
# KONSEKUENSI jika bernilai 0/false saat di balik reverse proxy: seluruh klien terdeteksi sebagai satu IP proxy (127.0.0.1)
# sehingga batas rate limiter (100 req/menit) terbagi ke semua pengguna dan memicu blokir 429 massal.
# Nilai yang didukung: 0 atau false (pengembangan lokal tanpa proxy), 1 (1 hop reverse proxy), 2 (2 hop proxy).
TRUST_PROXY=0

# Resend Email Integration (Backend Only, opsional / mode simulasi jika kosong)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=SIMANTIK Diskominfo <noreply@simantik.bandungkab.go.id>

# ==========================================
# FRONTEND SERVICE WEB (Publik)
# ==========================================
VITE_API_BASE_URL=http://localhost:3000/api/v1

# ==========================================
# FRONTEND ADMIN WEB (Diskominfo)
# ==========================================
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-publishable-key
